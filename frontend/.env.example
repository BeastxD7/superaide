# Copy to .env.local to change these. The browser always calls /api on this
# server, which forwards to the backend; nothing here is sent to the browser.

# Where this server reaches the backend API.
API_INTERNAL_URL=http://127.0.0.1:8000
# Must match the backend's SESSION_COOKIE_NAME.
SESSION_COOKIE_NAME=superaide_session
# Trust the X-Forwarded-For header the reverse proxy (Caddy) sets, so per-address sign-up and log-in limits see the real
# client. true | false. Default unset (not trusted). Set true ONLY when every request reaches this server through your own
# proxy; docker-compose.prod.yml sets it for you. A warning is logged at startup when it looks wrong.
# TRUST_PROXY_HEADERS=true
# Host names (comma-separated) allowed to open the dev server besides 127.0.0.1, for example a phone on your Wi-Fi.
# start.command sets it. Development only. Default empty.
# DEV_ORIGINS=
# Build output: "standalone" makes a self-contained server (the Docker image uses it). Default unset (normal build).
# NEXT_OUTPUT=standalone
# Build directory. Default .next. Used by tests and parallel builds.
# NEXT_DIST_DIR=.next
# NEXT_PUBLIC_* are read at BUILD time and baked into the bundle: set them before `npm run build` or `npm run dev`.
# Installable app (PWA: manifest, service worker, install prompt, Settings notifications card). 1 = on. Default unset (off) for
# local work; docker-compose.prod.yml builds the public server with it on (NEXT_PUBLIC_PWA in .env.prod.example).
# NEXT_PUBLIC_PWA=1
# Page the installed app opens at. Default /dashboard/chat.
# NEXT_PUBLIC_PWA_START_URL=/dashboard/chat
# Bottom tab bar on phones. 1 = on. Default unset (off).
# NEXT_PUBLIC_MOBILE_TABS=1
