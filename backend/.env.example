# Copy to .env and fill in. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent
# Optional, to run as the app's own role so Row-Level Security applies (ADR 0009; deploy/README.md):
#   DATABASE_URL=postgresql+psycopg://superaide_app:<APP_DB_PASSWORD>@localhost:5432/agent
#   MIGRATION_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent   # migrations, db-app-role
TEST_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_test
# Connection pool of each process (API, worker). At most (size + overflow) // 2 - 1 chat turns run at once,
# because a turn holds a connection and the spend guard takes a second. Postgres max_connections (100 by
# default) must cover size + overflow for every process that connects.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# How many identity-link codes may go to one person in a day, across every account claiming to be them.
# LINK_CHALLENGES_PER_PERSON_PER_DAY=6

# --- Agent ---
AGENT_NAME=Ava

# --- Claude API (https://platform.claude.com) ---
ANTHROPIC_API_KEY=
# Hard cap on total Claude API spend for this build, in US dollars.
MAX_SPEND_USD=10
# Rolling limits inside the lifetime cap (0 turns one off): any 24 hours, any 30 days,
# and per kind of work in any 24 hours.
BUDGET_DAILY_USD=0.50
BUDGET_MONTHLY_USD=5.00
BUDGET_DAILY_BY_BUCKET={"chat": 0.40, "memory": 0.15, "research": 0.25, "triage": 0.05, "receptionist": 0.10}
# These limits apply to each hired Ava separately. Calls paid with Superaide's own model key
# (Superaide AI credits, below) also share one platform-wide allowance per UTC day; 0 refuses them all.
PLATFORM_DAILY_CAP_USD=0
# Superaide AI credits: owners may use the platform's own Claude key instead of bringing theirs.
# Off unless PLATFORM_AI_ENABLED=true. The key is PLATFORM_ANTHROPIC_API_KEY (else ANTHROPIC_API_KEY);
# it is only used for owners who opt in on the AI model page, and their own key always comes first.
PLATFORM_AI_ENABLED=false
# Accounts whose own Ava uses ANTHROPIC_API_KEY as its own key even when hosted (the operator's),
# with the normal per-Ava budget, outside the credits. Comma-separated; the account must already exist.
PLATFORM_KEY_OWNER_EMAILS=
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_MODEL=claude-haiku-5-5
# Each owner's share of the credits (rolling 24 hours / 30 days), inside PLATFORM_DAILY_CAP_USD.
PLATFORM_OWNER_DAILY_USD=0.50
PLATFORM_OWNER_MONTHLY_USD=5.00
# Embeddings for recall: local (default; on this machine, free, ~220 MB model downloaded once),
# voyage (Voyage AI's API: private facts leave the machine; needs VOYAGE_API_KEY), or none.
EMBEDDER=local
EMBED_MODEL_LOCAL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_CACHE_DIR=
VOYAGE_API_KEY=
EMBED_MODEL_VOYAGE=voyage-4-lite
EMBED_MONTHLY_USD=1.00
# Real Claude replies whenever ANTHROPIC_API_KEY is set. FAKE_LLM=true forces offline echo mode.
FAKE_LLM=false
# self_hosted (default): local model servers (Ollama, vLLM) on this machine or network are allowed.
# hosted: many owners on shared servers; no owner-typed address may reach private or internal ranges.
DEPLOY_MODE=self_hosted
# Web search for models without a built-in one (Claude has its own). Brave Search API key, and what
# one search costs on your plan (charged against the cap before each search).
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_USD_PER_CALL=0.01
MODEL_CHAT=claude-haiku-5-5
MODEL_TRIAGE=claude-haiku-5-5
MODEL_DEEP=claude-opus-5-5

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Only needed for webhook mode; any random string of letters, digits, _ and -
TELEGRAM_WEBHOOK_SECRET=

# --- Google: one OAuth client (Web application) for sign-in and Calendar (deploy/README.md) ---
# Redirect URIs to register on it: <FRONTEND_ORIGIN>/api/auth/google/callback (sign-in) and
# <FRONTEND_ORIGIN>/api/app/connections/google/callback (Calendar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SIGNIN_ENABLED=false
# Calendar push (events.watch): needs a public https PUBLIC_BASE_URL and the /webhooks/* route open.
GOOGLE_CALENDAR_PUSH=false
PUBLIC_BASE_URL=
# "Continue with Google" works at FRONTEND_ORIGIN only, unless you also register another address of the
# app (for example http://127.0.0.1:3000) with Google and list it here (comma-separated origins).
# GOOGLE_REDIRECT_ORIGINS=

# --- Slack (Socket Mode app; see slack-manifest.yml) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Your workspace's team ID (starts with T). Anyone from another team is treated as external.
SLACK_TEAM_ID=

# --- Frontend and operator console ---
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
FRONTEND_ORIGIN=http://localhost:3000
# Links in emails use the address the person opened the app at, when it's one of these (else
# PUBLIC_BASE_URL, else FRONTEND_ORIGIN). Comma-separated, * allowed in the host. DEV_ORIGINS
# (host names, set by start.command for a phone on your Wi-Fi) count too.
# LINK_ORIGINS=https://*.trycloudflare.com
# PUBLIC_BASE_URL=
# Dev only: lets the operator console inject pretend messages to try impostor scenarios.
ENABLE_SIMULATOR=true

# Triage and escalation (ADR 0010, being built): record a handle/hold/interrupt decision for every
# message from someone other than the owner, and escalate interrupts until acknowledged. Off by default.
TRIAGE_ENABLED=false
# "Ask my Ava" link (being built): a public /a/<handle> intake page an owner can publish. Off by default.
ASK_LINK_ENABLED=false
# Signs the public form's token. Blank: a random key per process (fine for one API process).
ASK_FORM_SECRET=
# How many new handles one owner may try to claim in a day (a "taken" answer would otherwise list handles).
# ASK_HANDLE_TRIES_PER_DAY=20
# Gmail inbox triage: poll each owner's inbox (history.list) and triage new mail. Needs TRIAGE_ENABLED.
GMAIL_TRIAGE_ENABLED=false
GMAIL_POLL_MINUTES=5
# Memory-free second opinion (#123): a second view with no memory on the owner's own claims, and a measured agreement rate. Off by default.
SECOND_OPINION_ENABLED=false
AGREEMENT_LIMIT=0.75
# Relationship safety (#124): fixed replies for heavy or "do you love me?" turns, no claims of feelings. Off by default.
RELATIONSHIP_SAFETY_ENABLED=false
# Skill Ratchet (#120): Ava drafts playbooks, only owner-edited ones go live. Off by default.
SKILL_RATCHET_ENABLED=false
# Overnight Tuner (#118): proposes a better triage prompt for you to approve; never changes anything itself. Off by default.
OVERNIGHT_TUNER_ENABLED=false
# Rubber-Stamp Brake (#134): fast, always-yes approvals need a typed reason on high-risk cards. Off by default.
RUBBER_STAMP_BRAKE_ENABLED=false
# Echo Filter (#137): facts heard via links, Telegram or Slack are hearsay until two independent origins or you confirm. Off by default.
ECHO_FILTER_ENABLED=false
# One Good Question (#121): at most one clarifying question to the owner a day. Off by default.
ONE_GOOD_QUESTION_ENABLED=false
# "Why did you say that?" (#122): ablation replay of a reply, a handful of small-model calls inside the spend cap. Off by default.
WHY_REPLAY_ENABLED=false
# Owner Twin (#119): a calibration page for a predictor of your approve/reject choices. Off by default.
OWNER_TWIN_ENABLED=false
# Web push to the owner's installed app (ADR 0011, being built). Off by default. When on, one VAPID
# key pair for this deployment is made on first use (platform_state, encrypted); VAPID_SUBJECT is how
# push services reach you.
PUSH_ENABLED=false
VAPID_SUBJECT=mailto:admin@localhost
# The interactive API reference at /docs. Production (docker-compose.prod.yml) turns it off.
ENABLE_API_DOCS=true

# --- Credentials vault ---
# The key that encrypts the credentials saved in the app. On a Mac it lives in the
# Keychain and you can leave these blank. On a server set one of them (deploy/README.md):
# SECRETS_MASTER_KEY=        # openssl rand -base64 32
# SECRETS_MASTER_KEY_FILE=   # or a file holding that value, e.g. /run/secrets/vault_master_key

# --- Email (verification and password-reset links) ---
# "log" prints each email, link included, to the API log: fine for development.
# "smtp" sends through any SMTP server or email provider.
MAIL_BACKEND=log
MAIL_FROM=Superaide <no-reply@localhost>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls     # starttls | ssl | none
# Hiring needs a confirmed email address (turn on once email is set up).
REQUIRE_VERIFIED_EMAIL=false
# Anyone who signs up can hire their own Ava, with its own memory, people, connections and spend
# (ADR 0009). false: single-owner mode, where the first account to hire Ava is its only owner.
ALLOW_MANY_OWNERS=true

# The introduction's voice call, v2 (docs/decisions/0012-voice-intro.md). Off: the original video call.
# On: hands-free turn-taking (voice detection in the browser), Claude interviewing, a natural voice,
# and a "what I learned" list the owner confirms before anything is saved. Without keys it is free:
# the browser's own speech recognition (Chrome, Edge, Safari) and its best system voice.
VOICE_INTRO_V2=false
# auto: the owner's own key (Connections), then Superaide credits, then the browser. fake: tests only.
VOICE_ASR=auto
VOICE_TTS=auto
VOICE_MAX_TURN_SECONDS=60
# Self-hosted only: used when no key was saved in Connections. Deepgram (speech-to-text, and English
# Aura voices): https://console.deepgram.com. ElevenLabs (natural voices): https://elevenlabs.io/app/settings/api-keys
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Superaide AI credits only: the platform's own voice keys, for owners who opted in.
PLATFORM_DEEPGRAM_API_KEY=
PLATFORM_ELEVENLABS_API_KEY=
