# Superaide backend settings. Copy to backend/.env, edit, restart the API (and worker). Never commit .env.
#
# Reading this file:
#   NAME=value     active in this example (equal to the code default unless the comment says otherwise)
#   # NAME=value   commented out: the value shown is the built-in default, so leaving it commented changes nothing;
#                  uncomment and edit to override
#   "Secret" means the value is a credential: keep it out of git, logs, screenshots and chat
# Every variable the backend or frontend reads appears here (frontend ones: frontend/.env.example) exactly once.
# `python3 scripts/check_env_example.py` (and the test suite) fail when one is missing or listed twice.
# The README section "Configuration and feature flags" explains each switch and how to set it up.
#
# ====================================================================================================
# FEATURE FLAGS INDEX: every true/false switch, its default and what it does (details at its entry below)
# ====================================================================================================
# Safe to turn on by yourself (cost and risk are bounded; see the README for setup):
#   MAIL_LOG_BODY                   true   with MAIL_BACKEND=log, log whole emails (links included); false = recipient and subject only
#   WEB_TOOLS_ENABLED               true   Ava may search and read the web (about US$0.01 a search from the research budget)
#   TRACE_RECORDER                  true   hashes-only record of every tool call (on by default; turn off only to save rows)
#   ENABLE_API_DOCS                 true   interactive API docs at /docs (turn off on a public server)
#   RUN_CHANNELS_IN_API             true   Telegram and Slack listeners inside the API process
#   RUN_JOBS_IN_API                 true   reminders, follow-ups, digests inside the API process
#   ALLOW_MANY_OWNERS               true   anyone who signs up may hire their own Ava (false = single-owner mode)
#   ENABLE_SIMULATOR                false  operator console impostor simulator (development only; example below sets true)
#   TRIAGE_ENABLED                  false  record a handle/hold/interrupt/defer/verify decision for non-owner messages
#   TRIAGE_KNN_ENABLED              false  shadow urgency score beside each triage decision (needs TRIAGE_ENABLED)
#   GMAIL_TRIAGE_ENABLED            false  poll each owner's Gmail inbox and triage new mail (needs TRIAGE_ENABLED, Google)
#   GOOGLE_SIGNIN_ENABLED           false  "Continue with Google" on log-in and sign-up (needs Google client id and secret)
#   GOOGLE_CALENDAR_PUSH            false  Google calendar change notifications (needs PUBLIC_BASE_URL on https)
#   PUSH_ENABLED                    false  web push to the owner's phone (makes a VAPID key pair on first use)
#   ECHO_FILTER_ENABLED             false  facts heard via links, Telegram or Slack are hearsay until confirmed
#   ONE_GOOD_QUESTION_ENABLED       false  Ava may ask the owner one clarifying question a day
#   SECOND_OPINION_ENABLED          false  memory-free second view on the owner's own claims (small-model calls)
#   WHY_REPLAY_ENABLED              false  "Why did you say that?" replay of a reply (small-model calls)
#   OWNER_TWIN_ENABLED              false  calibration page scoring a predictor of the owner's approve/reject choices
#   SKILL_RATCHET_ENABLED           false  Ava drafts playbooks; only owner-edited ones go live
#   OVERNIGHT_TUNER_ENABLED         false  proposes a better triage prompt; nothing changes until the owner approves
#   REHEARSAL_ENABLED               false  practise a hard conversation with Ava playing the other side
#   SCHOOL_ENABLED                  false  Ava School: write, consent to and export generic lessons (local only)
#   RELATIONSHIP_SAFETY_ENABLED     false  fixed replies for heavy or "do you love me?" owner messages
#   RUBBER_STAMP_BRAKE_ENABLED      false  adds friction to fast always-yes approvals (can only add friction)
#   MEMORY_RECHECK_ENABLED          false  digest may ask "is this still true?" about a few lasting facts a week
#   SLEEP_JOB_ENABLED               false  nightly job that groups conversations into episodes and removes exact duplicates
#   VOICE_INTRO_V2                  false  conversational voice interview in the introduction call
#   SURFACE_CHECK_ON_BOOT           false  refuse to start if a protected file differs from security/surface.lock.json
#   ACTION_LOG                      false  hash-chained log of tool calls and executed approvals
# Needs an owner decision first (spends money, sends data elsewhere, widens what Ava may do, or is public):
#   FAKE_LLM                        false  true forces offline echo replies and nothing is spent (tests, demos)
#   PLATFORM_AI_ENABLED             false  owners may use the server's own Claude key as "Superaide AI credits" (costs you)
#   ASK_LINK_ENABLED                false  public /a/<handle> intake pages owners can publish (public, unauthenticated)
#   IMPORT_LEASE_ENABLED            false  import context cards from a third-party export under a time-limited lease
#   AIRLOCK_ENABLED                 false  replace contact details, cards and ID-like numbers with placeholders before a model call
#   CIRCUIT_BREAKER_ENABLED         false  too many deletes or sends in a window freezes Ava; the halt word freezes her at once
#   FOOTPRINT_GUARD_ENABLED         false  creating accounts, profiles or public posts needs approval; flags unknown names
#   PRINCIPAL_CARD_ENABLED          false  outbound Gmail replies carry a line and signed public page saying Ava is an AI
#   MANDATES_ENABLED                false  signed, narrowing mandate cards let Ava do a named limited thing without asking
#   MCP_PINNING                     false  block an MCP tool whose description or schema changed since the owner approved it
#   MEMORY_SOCKET_ENABLED           false  read-only MCP endpoint POST /mcp/memory for the owner's other assistants
#   DISSENT_DESK_ENABLED            false  three different models answer high-stakes choices (needs DISSENT_MODELS; costs more)
#   FORK_NIGHT_ENABLED              false  three read-only overnight drafts of a choice the owner leaves (model calls)
#   TIME_TRAVEL_RULES_ENABLED       false  standing orders compiled to rules, replayed on past messages, shadow-run first
#   QUOTE_ODDS_ENABLED              false  approval cards show honest odds; low-odds approvals prepare instead of run
#   VOICE_TWO_CHANNEL               false  a voice-call action becomes an approval that only a text-channel tap can approve
#   ALLOW_UNSAFE_PUBLIC_SELF_HOSTED false  override the startup refusal of a public open-sign-up self-hosted server (do not)
#   REQUIRE_VERIFIED_EMAIL          false  hiring needs a confirmed email (turn on once MAIL_BACKEND=smtp works)
#   SESSION_COOKIE_SECURE           false  send the session cookie over HTTPS only (must be true on any https server)
# Not booleans but switches too:
#   APPROVAL_BINDING                record off | record | strict: check an approval still matches what the owner saw
#   EMBEDDER                        local  local | voyage | fake | none (voyage sends private facts to Voyage AI)
#   DEPLOY_MODE                     self_hosted  self_hosted | hosted (hosted blocks owner-typed private addresses)
#   MAIL_BACKEND                    log    log | smtp (log writes each email, links included, to the API log)
#   VOICE_ASR / VOICE_TTS           auto   speech-to-text / text-to-speech provider choice
# END FEATURE FLAGS INDEX

# ====================================================================================================
# Database
# ====================================================================================================
# Postgres 17 with pgvector (docker compose up -d db). Secret (contains a password). Default shown.
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent
# Schema owner for migrations and `superaide db-app-role`, so DATABASE_URL can be the app's own role (no superuser,
# no BYPASSRLS) and Row-Level Security applies (ADR 0009, deploy/README.md). Secret. Default empty = use DATABASE_URL.
# MIGRATION_DATABASE_URL=
# Postgres used by the test suite only. The tests WIPE it, so it must differ from DATABASE_URL (conftest refuses otherwise).
# Read by tests and `make test`, not by the app. Default shown.
TEST_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_test
# Postgres used by `python -m superaide.evals` (every scenario wipes it, so never your real database). Evals only.
# Default: a database named agent_eval on localhost.
# EVAL_DATABASE_URL=
# Connection pool per process (API, worker). At most (size + overflow) // 2 - 1 chat turns run at once, because a turn holds
# a connection and the spend guard takes a second. Postgres max_connections (100 by default) must cover size + overflow for
# every process that connects. Integers >= 1 (overflow >= 0); timeout in seconds. Defaults shown.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# ====================================================================================================
# Deployment mode and tenancy
# ====================================================================================================
# self_hosted: local model servers (Ollama, vLLM) on this machine or network are allowed. hosted: many owners on shared
# servers; no owner-typed address may reach private, loopback, link-local or metadata ranges. self_hosted | hosted.
DEPLOY_MODE=self_hosted
# true: run a self-hosted server with open sign-up and this server's own keys on a public address anyway. Leave false:
# the startup check refuses that combination because sign-ups would spend your keys. Default false.
# ALLOW_UNSAFE_PUBLIC_SELF_HOSTED=false
# Fixed ids every row carries so the project can go multi-tenant later. Do not change on an existing database.
# TENANT_ID=00000000-0000-4000-8000-000000000001
# AGENT_ID=00000000-0000-4000-8000-000000000002
# The name the agent introduces itself with. Default Ava.
AGENT_NAME=Ava
# Run the Telegram and Slack listeners inside the API process (follow connections made in the app). true | false. Default true.
# Production compose sets false on the api and runs them in the worker.
# RUN_CHANNELS_IN_API=true
# Run background jobs (reminders, follow-ups, digests) inside the API process. true | false. Default true. Same note.
# RUN_JOBS_IN_API=true
# Days a delivered reminder stays open before it is closed for the owner (marked done, audited). 0 = never. Default 7.
# REMINDER_AUTO_CLOSE_DAYS=7
# Empty the text of third parties' messages older than this many days. 0 = never (deleting by age is the owner's call). Default 0.
# THIRD_PARTY_MESSAGE_RETENTION_DAYS=0

# ====================================================================================================
# Claude API and spend limits (https://platform.claude.com)
# ====================================================================================================
# Anthropic API key. Secret. Blank = offline echo replies, nothing spent (owners can also connect their own key in the app).
ANTHROPIC_API_KEY=
# true forces the scripted offline model even when a key is set. true | false. Default false.
FAKE_LLM=false
# Models by role. A bare id runs on Claude; "<preset>::<model>" runs on a provider the owner connected in the app. A model
# missing from the price table (brain/pricing.py) is refused, so add its prices when you change these.
MODEL_CHAT=claude-haiku-5-5
MODEL_TRIAGE=claude-haiku-5-5
MODEL_DEEP=claude-opus-5-5
# Hard ceiling on total Claude API spend for this build, in US dollars (number). Default 10.
MAX_SPEND_USD=10
# Rolling limits inside the lifetime cap, in US dollars (0 turns one off): any 24 hours, any 30 days. Defaults shown.
BUDGET_DAILY_USD=0.50
BUDGET_MONTHLY_USD=5.00
# Per kind of work, any 24 hours, as JSON {"bucket": usd}. Default (all ten buckets) shown; a bucket you leave out has no limit of
# its own (the daily and monthly limits still apply), so copy the whole object when you change one.
# BUDGET_DAILY_BY_BUCKET={"chat": 0.40, "dissent": 0.10, "fork": 0.15, "rules": 0.02, "memory": 0.15, "research": 0.25, "triage": 0.05, "voice": 0.30, "receptionist": 0.10, "learning": 0.10}
# These limits apply to each hired Ava separately. Calls paid with Superaide's own model key (credits, below) also share one
# platform-wide allowance per UTC day, in US dollars; 0 refuses them all. Default 0.
PLATFORM_DAILY_CAP_USD=0

# --- Superaide AI credits (optional; costs you money, so an owner decision) ---
# Owners may use the platform's own Claude key instead of bringing theirs, only after they opt in on the AI model page, and
# their own key always comes first. true | false. Default false.
PLATFORM_AI_ENABLED=false
# The platform's Claude key (else ANTHROPIC_API_KEY is used). Secret. Never shown, logged or stored in an owner's vault.
PLATFORM_ANTHROPIC_API_KEY=
# Model every role runs on when credits pay. Default claude-haiku-5-5.
PLATFORM_MODEL=claude-haiku-5-5
# Each owner's share of the credits (rolling 24 hours / 30 days, US dollars), inside PLATFORM_DAILY_CAP_USD. Defaults shown.
PLATFORM_OWNER_DAILY_USD=0.50
PLATFORM_OWNER_MONTHLY_USD=5.00
# Accounts (comma-separated emails) whose own Ava uses ANTHROPIC_API_KEY as its own key even when hosted: the operator's.
# Normal per-Ava budget, outside the credits. Emails are not verified, so list only accounts that already exist. Default empty.
PLATFORM_KEY_OWNER_EMAILS=

# --- Web search and reading ---
# Let Ava search and read the web for the owner (about US$0.01 a search, from the research budget). true | false. Default true.
# WEB_TOOLS_ENABLED=true
# Brave Search API key, for models without built-in search (Claude has its own). Secret. Default empty.
BRAVE_SEARCH_API_KEY=
# What one search costs on your plan in US dollars, charged against the cap before each search. Default 0.01.
WEB_SEARCH_USD_PER_CALL=0.01

# --- Embeddings for recall ---
# local: on this machine, free, about 220 MB model downloaded once. voyage: Voyage AI's API, so private facts leave the
# machine (needs VOYAGE_API_KEY). fake: tests. none: no embeddings. Default local.
EMBEDDER=local
# Local model name (50+ languages). Default shown.
EMBED_MODEL_LOCAL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Where the local model is kept. Default empty = ~/.cache/superaide/models.
EMBED_CACHE_DIR=
# Voyage AI key. Secret. Only used when EMBEDDER=voyage.
VOYAGE_API_KEY=
EMBED_MODEL_VOYAGE=voyage-4-lite
# Cap on Voyage spend in any 30 days, US dollars (local costs nothing). Default 1.00.
EMBED_MONTHLY_USD=1.00

# ====================================================================================================
# Telegram (token from @BotFather). Easier: connect it in the app (Workspace > Connections).
# ====================================================================================================
# Bot token. Secret. Blank = no bot from .env.
TELEGRAM_BOT_TOKEN=
# Webhook mode only: any random string of letters, digits, _ and -. Secret.
TELEGRAM_WEBHOOK_SECRET=
# Public https address of this server (for example https://ava.example.com). When set, each owner's bot gets a webhook at
# <this>/webhooks/telegram/<endpoint> with its own secret instead of polling (ADR 0009). Default empty = polling.
# TELEGRAM_WEBHOOK_BASE_URL=

# ====================================================================================================
# Slack (Socket Mode app; see backend/src/superaide/channels/slack_manifest.yml). Easier: connect it in the app.
# ====================================================================================================
# Bot token (xoxb-...). Secret.
SLACK_BOT_TOKEN=
# App-level token (xapp-...) for Socket Mode. Secret.
SLACK_APP_TOKEN=
# Signing secret that verifies Slack requests. Secret.
SLACK_SIGNING_SECRET=
# Your workspace's team ID (starts with T). Anyone from another team is treated as external. Not secret.
SLACK_TEAM_ID=

# ====================================================================================================
# Google: one OAuth client (type "Web application") for sign-in, Calendar and Gmail (deploy/README.md)
# ====================================================================================================
# In the Google Cloud project enable BOTH the Google Calendar API and the Gmail API, and under Data access add the
# calendar.readonly, calendar.events, gmail.readonly and gmail.compose scopes. Redirect URIs to register on the client:
# <FRONTEND_ORIGIN>/api/auth/google/callback (sign-in) and <FRONTEND_ORIGIN>/api/app/connections/google/callback (Calendar).
GOOGLE_CLIENT_ID=
# Secret.
GOOGLE_CLIENT_SECRET=
# "Continue with Google" on log-in and sign-up. Needs the client id and secret. true | false. Default false (off: /auth/google/* answer 404).
GOOGLE_SIGNIN_ENABLED=false
# Calendar change notifications (events.watch) so meeting prep notices new meetings at once. Needs a public https
# PUBLIC_BASE_URL and the /webhooks/* route open. true | false. Default false (the 30-minute scan runs either way).
GOOGLE_CALENDAR_PUSH=false
# Public https address of this API as Google and other services reach it (for example https://ava.example.com). Also used for
# links in emails (before FRONTEND_ORIGIN). Default empty = TELEGRAM_WEBHOOK_BASE_URL.
PUBLIC_BASE_URL=
# Extra origins registered with Google as authorised redirect URIs besides FRONTEND_ORIGIN (comma-separated exact origins,
# no wildcards; each must also be allowed by LINK_ORIGINS or DEV_ORIGINS), for example http://127.0.0.1:3000. Default empty.
# GOOGLE_REDIRECT_ORIGINS=
# Calendar refresh token for a self-hosted server. Secret. Normally leave blank: each owner signs in from Connections and the
# token is kept in their vault.
# GOOGLE_REFRESH_TOKEN=
# Gmail refresh token, same rules. Secret.
# GMAIL_REFRESH_TOKEN=
# End-to-end tests only: a fake Google at this address replaces accounts.google.com, and only while ENABLE_SIMULATOR is on.
# Never set on a real server. Default empty.
# GOOGLE_FAKE_BASE_URL=

# ====================================================================================================
# Operator console, origins and API surface
# ====================================================================================================
# Bearer token for /api/* and the operator console at /console. Secret. Make one with:
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"   (start.command fills this in when blank)
ADMIN_TOKEN=
# The browser origin the API accepts (CORS) and builds links from. Default http://localhost:3000.
FRONTEND_ORIGIN=http://localhost:3000
# Other addresses people may open the app at, for links in emails (comma-separated, * allowed in the host), for example
# https://*.trycloudflare.com (a phone or tunnel). Links use the address the person opened the app at when listed here, else
# PUBLIC_BASE_URL, else FRONTEND_ORIGIN. Default empty.
# LINK_ORIGINS=
# Host names (comma-separated) that count like LINK_ORIGINS; start.command sets this for a phone on your Wi-Fi. Default empty.
# DEV_ORIGINS=
# Development only: lets the operator console inject pretend messages to try impostor scenarios. true | false.
# The code default is false (this example turns it on for local development); production compose forces false.
ENABLE_SIMULATOR=true
# The interactive API reference (/docs, /redoc, /openapi.json). true | false. Default true; production compose forces false.
ENABLE_API_DOCS=true

# ====================================================================================================
# Credentials vault (keys saved in the app are encrypted with AES-256-GCM under one master key)
# ====================================================================================================
# On a Mac the key lives in the Keychain, elsewhere in a key file, so you can leave these blank. On a server set one of
# them (deploy/README.md). Secret. Back it up: without it a database backup cannot decrypt saved keys.
# NOTE: these three are read from the process environment only, NOT from this file. Export them in the shell or service
# that starts the API (docker-compose.prod.yml passes SECRETS_MASTER_KEY through for you).
# SECRETS_MASTER_KEY=        # openssl rand -base64 32
# or a file holding that value, for example /run/secrets/vault_master_key
# SECRETS_MASTER_KEY_FILE=
# Where the master key file is kept when no Keychain or env value is used. Default ~/.config/superaide/master.key.
# SUPERAIDE_KEY_FILE=

# ====================================================================================================
# Accounts and sessions
# ====================================================================================================
# Session cookie name. The frontend must use the same value (frontend/.env.example). Default superaide_session.
# SESSION_COOKIE_NAME=superaide_session
# true when served over HTTPS (the cookie is then never sent over plain http). true | false. Default false.
# Production compose forces true.
# SESSION_COOKIE_SECURE=false
# Sliding session length in days, counted from the last use. Default 30.
# SESSION_DAYS=30
# Wrong passwords per account before it locks, and for how many minutes. Defaults 5 and 15.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# Failed log-ins per address per 15 minutes, and sign-ups per address per hour. Defaults 20 and 10.
# LOGIN_FAILURES_PER_IP=20
# SIGNUPS_PER_IP_PER_HOUR=10
# Anyone who signs up can hire their own Ava with its own memory, people, connections and spend (ADR 0009). false =
# single-owner mode: the first account to hire Ava is its only owner. true | false. Default true.
ALLOW_MANY_OWNERS=true
# Hiring needs a confirmed email address. Turn on once email below works. true | false. Default false.
REQUIRE_VERIFIED_EMAIL=false
# How long a verification link and a password-reset link stay valid (hours, minutes), and how many such emails one account
# may request per hour. Defaults 48, 30 and 5.
# VERIFY_LINK_HOURS=48
# RESET_LINK_MINUTES=30
# EMAIL_LINKS_PER_ACCOUNT_PER_HOUR=5

# --- Identity linking (adding Telegram or Slack to a person) ---
# One-time code lifetime in minutes, wrong tries per code, codes per day per platform identity, codes per day per person
# (across all accounts claiming to be them). Defaults 10, 5, 3, 6.
# LINK_CODE_TTL_MINUTES=10
# LINK_CODE_MAX_ATTEMPTS=5
# LINK_CHALLENGES_PER_IDENTITY_PER_DAY=3
# LINK_CHALLENGES_PER_PERSON_PER_DAY=6
# A linked Telegram/Slack account silent this many days must be confirmed again in the app. 0 = never. Default 30.
# LINK_RECONFIRM_AFTER_DAYS=30

# ====================================================================================================
# Email (verification and password-reset links)
# ====================================================================================================
# log: writes each email, live links included, to the API log (development only). smtp: sends through any SMTP server.
MAIL_BACKEND=log
# With MAIL_BACKEND=log: true writes the whole email, live verification and reset links included, to the API log; false logs
# only the recipient and subject (the end-to-end suite uses false). true | false. Default true.
# MAIL_LOG_BODY=true
# The From header. Default "Superaide <no-reply@localhost>".
MAIL_FROM=Superaide <no-reply@localhost>
# SMTP server for MAIL_BACKEND=smtp. Default empty.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP login. Not needed for an open relay. Default empty.
# SMTP_USERNAME=
# Secret.
# SMTP_PASSWORD=
# starttls | ssl | none. Default starttls.
# SMTP_SECURITY=starttls
# Seconds to wait for the server. Default 15.
# SMTP_TIMEOUT_SECONDS=15

# ====================================================================================================
# Triage, Gmail and escalation (ADR 0010). All off by default.
# ====================================================================================================
# Record a handle/hold/interrupt/defer/verify decision for every message from someone other than the owner and escalate
# interrupts until acknowledged. true | false. Default false.
TRIAGE_ENABLED=false
# Deletable kNN triage head (#117): records a shadow urgency score from your own feedback beside each decision; never changes a
# decision. Needs TRIAGE_ENABLED. true | false. Default false.
TRIAGE_KNN_ENABLED=false
# Poll each owner's Gmail inbox (history.list) and triage new mail. Needs TRIAGE_ENABLED and the Google client above.
# Off: Gmail is read only when the owner asks in chat. true | false. Default false.
GMAIL_TRIAGE_ENABLED=false
# Minutes between inbox polls. Default 5.
GMAIL_POLL_MINUTES=5
# Overnight Tuner (#118): /app/tuner proposes a better triage prompt; nothing changes until the owner approves. true | false. Default false.
OVERNIGHT_TUNER_ENABLED=false

# ====================================================================================================
# Honesty, memory and safety features (built behind flags, tracking #142). All off by default.
# ====================================================================================================
# Second opinion (#123): a memory-free second view on the owner's own claims or choices (up to two small-model calls per
# judged message); above AGREEMENT_LIMIT the reply carries the strongest case for the other side. true | false. Default false.
SECOND_OPINION_ENABLED=false
# Agreement rate (0 to 1) above which the other side is argued. Default 0.75.
AGREEMENT_LIMIT=0.75
# Relationship safety (#124): fixed human-written replies for heavy or "do you love me?" owner messages, no claims of
# feelings, a reach-out-to-a-person rule. All in code. true | false. Default false.
RELATIONSHIP_SAFETY_ENABLED=false
# Skill Ratchet (#120): /app/playbooks; Ava drafts playbooks, only owner-edited ones go live, at most 50 active. true | false. Default false.
SKILL_RATCHET_ENABLED=false
# Rubber-Stamp Brake (#134): when recent approvals are all yes and faster than a card can be read, high-risk cards need a typed
# reason. Only adds friction. true | false. Default false.
RUBBER_STAMP_BRAKE_ENABLED=false
# Echo Filter (#137): facts from a link, Telegram or Slack are stored as hearsay with their origin until a second independent
# origin or the owner confirms. true | false. Default false.
ECHO_FILTER_ENABLED=false
# One Good Question (#121): /app/question; at most one clarifying question a day. true | false. Default false.
ONE_GOOD_QUESTION_ENABLED=false
# "Why did you say that?" (#122): /app/why/*; each request costs up to REPLAY_MAX_ABLATIONS + 1 small-model calls inside the cap.
# true | false. Default false.
WHY_REPLAY_ENABLED=false
# Most ablation calls one replay may make. Default 8.
# REPLAY_MAX_ABLATIONS=8
# Owner Twin (#119): /app/twin; a calibration page scoring a predictor of the owner's approve/reject choices (reads approvals,
# grants nothing). true | false. Default false.
OWNER_TWIN_ENABLED=false
# Rehearsal room (#58): practise a hard conversation with Ava playing the other side; nothing is sent to anyone and the session
# is deleted after a day. /app/rehearsal/*. true | false. Default false.
REHEARSAL_ENABLED=false
# Ava School (#57), local half: write generic lessons, consent to each, export to a file or import one. No network sharing.
# /app/school/*. true | false. Default false.
SCHOOL_ENABLED=false
# Nightly sleep job (#50): groups the day's conversations into episodes and tidies notes (exact duplicates only, at most a
# quarter a night, pre-image saved first). true | false. Default false.
SLEEP_JOB_ENABLED=false
# Local hour (0 to 23, in the owner's time zone) the sleep job runs. Default 3.
# SLEEP_JOB_HOUR=3
# Spaced "is this still true?" (#49): the digest may carry a few lasting facts to re-confirm, never as an interruption.
# true | false. Default false.
MEMORY_RECHECK_ENABLED=false
# Most such questions per week. Default 2.
# MEMORY_RECHECK_PER_WEEK=2
# Import lease (#133): /app/import-leases/*; bring in context cards converted on the owner's machine from a third-party export,
# under a time-limited lease that erases them. true | false. Default false.
IMPORT_LEASE_ENABLED=false
# Airlock (#128, code half): contact details, cards and ID-like numbers become placeholders before a model sees the conversation,
# and the reply gets the originals back. true | false. Default false.
AIRLOCK_ENABLED=false
# Two-channel voice (#125): an action heard on a call becomes an approval marked voice-origin that only a tap in a text channel can
# approve. true | false. Default false.
VOICE_TWO_CHANNEL=false

# ====================================================================================================
# Approvals, accountability and guardrails
# ====================================================================================================
# Bind an approval to the content the owner saw (#111). off: not checked. record: a mismatch is audited but the send goes
# ahead. strict: a mismatch is not sent. Default record.
# APPROVAL_BINDING=record
# Hours before an unanswered approval request can no longer be approved. 0 = never expires. Default 0 (an owner's call).
# APPROVAL_TTL_HOURS=0
# Every tool call recorded as hashes only (#110). true | false. Default true.
# TRACE_RECORDER=true
# Hash-chained log of tool calls and executed approvals (#113). true | false. Default false.
# ACTION_LOG=false
# Refuse to start when a protected file differs from security/surface.lock.json (#114). true | false. Default false.
# SURFACE_CHECK_ON_BOOT=false
# Mandate cards (#112): a signed, narrowing token lets Ava do a named, limited thing without asking each time; never covers
# send or spend. true | false. Default false.
# MANDATES_ENABLED=false
# MCP pinning (#116): an MCP tool whose description, schema or annotations differ from what the owner approved is blocked.
# true | false. Default false (no MCP client calls it yet).
# MCP_PINNING=false
# Circuit breaker (#140): more than CIRCUIT_BREAKER_LIMIT deletes or sends inside CIRCUIT_BREAKER_WINDOW_SECONDS freeze that
# owner's Ava (the kill switch), and the owner's message that is exactly HALT_WORD freezes her before any model sees it.
# true | false. Default false.
# CIRCUIT_BREAKER_ENABLED=false
# CIRCUIT_BREAKER_LIMIT=5
# CIRCUIT_BREAKER_WINDOW_SECONDS=60
# HALT_WORD=halt
# Footprint Guard (#136): creating something in the world under the owner's name (account, profile, public post, pull request,
# review) always needs approval and is logged; an outbound message naming someone outside the owner's contacts is flagged.
# true | false. Default false.
# FOOTPRINT_GUARD_ENABLED=false
# Principal Card (#135): an outbound Gmail reply carries one honest line and a link to a signed public page saying Ava is an AI
# acting for the owner (only when the owner has a display name). true | false. Default false.
# PRINCIPAL_CARD_ENABLED=false
# Days the principal card page stays valid (1 to 365). Default 30.
# PRINCIPAL_CARD_DAYS=30
# Quote and Odds (#139): approval cards show honest odds from logged outcomes; at QUOTE_MIN_SAMPLES outcomes with a success rate
# below QUOTE_MIN_SUCCESS, approving prepares the action instead of running it. true | false. Default false.
# QUOTE_ODDS_ENABLED=false
# QUOTE_MIN_SAMPLES=5
# QUOTE_MIN_SUCCESS=0.5

# ====================================================================================================
# Memory socket, dissent, fork night, time-travel rules (all off by default)
# ====================================================================================================
# Memory Socket (#138): read-only MCP endpoint POST /mcp/memory for the owner's other assistants (one token per consumer, a scope
# the owner picks, audience-filtered in SQL, rate limited, access log). true | false. Default false.
# MEMORY_SOCKET_ENABLED=false
# Requests per minute per consumer. Default 30.
# MEMORY_SOCKET_PER_MINUTE=30
# Dissent Desk (#126): three DIFFERENT models answer a high-stakes choice independently; code decides if a minority view is
# shown. Costs more (bucket "dissent"). true | false. Default false.
# DISSENT_DESK_ENABLED=false
# Comma-separated model ids the provider layer can route. Required for the desk to run. Default empty.
# DISSENT_MODELS=
# Only choices at or above this stake (1 to 5) run. Default 3.
# DISSENT_MIN_STAKES=3
# Fork Night (#127): overnight, three read-only drafts of a choice the owner left (no tools, no outside content; bucket "fork").
# true | false. Default false.
# FORK_NIGHT_ENABLED=false
# Local hour (0 to 23) they run. Default 2.
# FORK_NIGHT_HOUR=2
# Time-travel rules (#52): a standing order in plain words is compiled to a deterministic rule, replayed on the last
# TIME_TRAVEL_REPLAY_DAYS of the owner's own messages, run in shadow first, promoted after TIME_TRAVEL_PROMOTE_AFTER agreeing
# firings. true | false. Default false.
# TIME_TRAVEL_RULES_ENABLED=false
# TIME_TRAVEL_REPLAY_DAYS=90
# TIME_TRAVEL_PROMOTE_AFTER=20
# TIME_TRAVEL_MIN_AGREEMENT=0.9

# ====================================================================================================
# "Ask my Ava" public intake link (being built). Off by default; it is a public page, so an owner decision.
# ====================================================================================================
# /a/<handle> page where anyone can leave a request (no model call for the visitor). Off: /p/ask/* and /app/ask-link/* answer 404.
ASK_LINK_ENABLED=false
# Signs the public form's token. Secret. Blank: a random key per process (fine for one API process; a restart only reloads the form).
ASK_FORM_SECRET=
# A form sent faster than this many seconds is a bot and is quietly dropped. Default 3.
# ASK_MIN_SECONDS=3
# Form token lifetime in seconds. Default 7200.
# ASK_TOKEN_MAX_AGE_S=7200
# Submissions per address per hour; per handle per hour; per handle per day. Defaults 5, 20, 100.
# ASK_PER_IP_PER_HOUR=5
# ASK_PER_HANDLE_PER_HOUR=20
# ASK_PER_HANDLE_PER_DAY=100
# How many new handles one owner may try to claim in a day (a "taken" answer would otherwise list handles). Default 20.
# ASK_HANDLE_TRIES_PER_DAY=20

# ====================================================================================================
# Voice (introduction call v2, ADR 0012) and web push (ADR 0011)
# ====================================================================================================
# Off: the original video call. On: hands-free turn-taking (voice detection in the browser), Claude interviewing, a natural
# voice and a "what I learned" list the owner confirms before anything is saved. Free without keys (the browser's own speech).
# true | false. Default false.
VOICE_INTRO_V2=false
# Speech-to-text: auto (the owner's own key, then Superaide credits, then the browser) | deepgram | browser | fake (tests).
VOICE_ASR=auto
# Text-to-speech: auto | elevenlabs | deepgram | browser | fake (tests).
VOICE_TTS=auto
# A longer answer than this many seconds is refused before it is transcribed. Default 60.
VOICE_MAX_TURN_SECONDS=60
# Self-hosted only: used when no key was saved in Connections. Deepgram (speech-to-text, English Aura voices):
# https://console.deepgram.com. ElevenLabs (natural voices): https://elevenlabs.io/app/settings/api-keys. Both Secret.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Superaide AI credits only: the platform's own voice keys, for owners who opted in. Server environment only. Both Secret.
PLATFORM_DEEPGRAM_API_KEY=
PLATFORM_ELEVENLABS_API_KEY=
# Web push to the owner's installed app. On: the first use makes one VAPID key pair for this deployment (encrypted in
# platform_state). /app/push/* answers 404 when off. true | false. Default false.
PUSH_ENABLED=false
# Who push services contact about this sender: use a real address in production. Default mailto:admin@localhost.
VAPID_SUBJECT=mailto:admin@localhost
# Every encrypted push is padded to this many plaintext bytes so its size reveals nothing. Default 1024.
# PUSH_PAD_BYTES=1024
# What a lock screen shows for a new device: none ("Ava / Needs you") | sender | reason. Default none.
# PUSH_DEFAULT_PREVIEW=none
# Seconds a push stays useful, and retries for 429 and 5xx answers inside it. Defaults 180 and 3.
# PUSH_TTL_SECONDS=180
# PUSH_MAX_ATTEMPTS=3
