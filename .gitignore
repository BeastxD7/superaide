# Secrets: never commit these
.env
.env.*
!.env.example
!.env.prod.example
*.pem
*.key
master.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# Local data (start.command's built-in database)
.local-db/

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# start.command installs Node here when the Mac has none
.tools/

# Production database dumps (deploy/backup.sh)
backups/

# Scenario evals: raw per-run output stays local; the committed scorecards are scorecard-*.{md,json}
backend/evals/results/*
!backend/evals/results/scorecard-live.md
!backend/evals/results/scorecard-live.json
!backend/evals/results/scorecard-offline.md
!backend/evals/results/scorecard-offline.json
# Triage reports (python -m superaide.evals triage): the committed record of each measured run
!backend/evals/results/triage-*.md
!backend/evals/results/triage-*.json
.run/
