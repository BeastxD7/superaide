# Production settings for docker-compose.prod.yml. Guide: deploy/README.md
#
#   cp .env.prod.example .env && chmod 600 .env
#
# deploy/bootstrap.sh fills in the REQUIRED values for you. Never commit .env.
# Back it up somewhere safe (a password manager): without SECRETS_MASTER_KEY a
# database backup can't decrypt the Claude/Telegram/Slack keys saved in the app.

# ---------------------------------------------------------------- REQUIRED
# The site's address, without https://. Its DNS A record must point at this server.
DOMAIN=ava.example.com

# Generate each with the command shown, once. Changing one later is covered in
# deploy/README.md ("Rotating secrets").
# openssl rand -hex 24    (hex, so it is safe inside a database URL)
POSTGRES_PASSWORD=
# openssl rand -hex 24    (the app's own database role, which can't bypass Row-Level Security)
APP_DB_PASSWORD=
# openssl rand -base64 32   (encrypts the credentials saved in the app; never lose it)
SECRETS_MASTER_KEY=
# openssl rand -hex 32      (the operator console's password: https://DOMAIN/console)
ADMIN_TOKEN=

# ---------------------------------------------------------------- Claude
# docker-compose.prod.yml runs the api and worker with DEPLOY_MODE=hosted, whatever this file says:
# every owner who signs up connects their own AI model, Telegram bot and Slack app in the app
# (Workspace > Connections), and the keys in this file are never used for an owner.
# The only uses of ANTHROPIC_API_KEY on this server: the account listed in PLATFORM_KEY_OWNER_EMAILS
# (the operator's own Ava) and Superaide AI credits (PLATFORM_AI_ENABLED, below).
# Do not remove DEPLOY_MODE from the compose file: without it, sign-ups would run on these keys.
ANTHROPIC_API_KEY=
# Hard cap on total Claude spend, in US dollars, and rolling limits inside it (0 turns one off).
MAX_SPEND_USD=10
BUDGET_DAILY_USD=0.50
BUDGET_MONTHLY_USD=5.00
BUDGET_DAILY_BY_BUCKET={"chat": 0.40, "memory": 0.15, "research": 0.25}
# These limits apply to each hired Ava separately. Calls paid with Superaide's own model key
# (Superaide AI credits, below) also share one platform-wide allowance per UTC day; 0 refuses them all.
PLATFORM_DAILY_CAP_USD=0
# Superaide AI credits: owners may use the platform's own Claude key instead of bringing theirs.
# Off unless PLATFORM_AI_ENABLED=true. The key is PLATFORM_ANTHROPIC_API_KEY (else ANTHROPIC_API_KEY);
# it is only used for owners who opt in on the AI model page, and their own key always comes first.
PLATFORM_AI_ENABLED=false
# Accounts whose own Ava uses ANTHROPIC_API_KEY as its own key even when hosted (the operator's),
# with the normal per-Ava budget, outside the credits. Comma-separated; the account must already exist.
PLATFORM_KEY_OWNER_EMAILS=
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_MODEL=claude-haiku-5-5
# Each owner's share of the credits (rolling 24 hours / 30 days), inside PLATFORM_DAILY_CAP_USD.
PLATFORM_OWNER_DAILY_USD=0.50
PLATFORM_OWNER_MONTHLY_USD=5.00
MODEL_CHAT=claude-haiku-5-5
MODEL_TRIAGE=claude-haiku-5-5
MODEL_DEEP=claude-opus-5-5
# true = offline placeholder replies, nothing spent.
FAKE_LLM=false
# Lets Ava search and read the web (US$0.01 a search, from the research budget).
WEB_TOOLS_ENABLED=true

# ---------------------------------------------------------------- Agent
AGENT_NAME=Ava

# ---------------------------------------------------------------- Telegram and Slack
# Easiest: connect both in the app. Telegram uses polling and Slack uses Socket Mode,
# so neither needs an inbound URL. These are only for configuring them here instead.
TELEGRAM_BOT_TOKEN=
# Only for webhook mode (also uncomment /webhooks in deploy/caddy/Caddyfile).
TELEGRAM_WEBHOOK_SECRET=
# Webhooks for every owner's own bot (each with its own secret): set to https://DOMAIN and
# uncomment /webhooks in deploy/caddy/Caddyfile. Empty: each bot is polled instead.
TELEGRAM_WEBHOOK_BASE_URL=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
# Run the listeners and the background jobs inside the API (keep true: there is one API process).
RUN_CHANNELS_IN_API=true
RUN_JOBS_IN_API=true

# ---------------------------------------------------------------- Google Calendar
# Your own OAuth client (Google Cloud console, type "Web application"). Its
# authorised redirect URI must be exactly:
#   https://DOMAIN/api/app/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Accounts
SESSION_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_FAILURES_PER_IP=20
SIGNUPS_PER_IP_PER_HOUR=10
# Hiring needs a confirmed email address. Turn on once email (below) works.
REQUIRE_VERIFIED_EMAIL=false
# Anyone who signs up can hire their own Ava, with its own memory, people, connections and spend
# (ADR 0009). false: single-owner mode, where the first account to hire Ava is its only owner.
ALLOW_MANY_OWNERS=true
# Web push to the owner's installed app (ADR 0011, being built). Off by default. When on, one VAPID
# key pair for this deployment is generated on first use and kept encrypted in platform_state.
# VAPID_SUBJECT is how Apple, Google and Mozilla's push services reach you: use a real address.
PUSH_ENABLED=false
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------- Email
# Verification and password-reset links. "log" only writes them to the API log
# (docker compose logs api); "smtp" sends through your SMTP server or email provider.
MAIL_BACKEND=log
MAIL_FROM=Superaide <no-reply@DOMAIN>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# ---------------------------------------------------------------- Fixed by docker-compose.prod.yml
# These are set by the compose file whatever you write here:
#   DATABASE_URL           built from POSTGRES_PASSWORD (Postgres runs in the stack)
#   FRONTEND_ORIGIN        https://DOMAIN
#   SESSION_COOKIE_SECURE  true
#   ENABLE_SIMULATOR       false
#   ENABLE_API_DOCS        false (/docs is never public)

# ---------------------------------------------------------------- Rarely needed
# Publish Caddy on other host ports, e.g. HTTPS_PUBLISH=127.0.0.1:8443 to test locally.
# HTTP_PUBLISH=80
# HTTPS_PUBLISH=443
# The public URL when it isn't https://DOMAIN (a non-standard port when testing).
# PUBLIC_URL=
